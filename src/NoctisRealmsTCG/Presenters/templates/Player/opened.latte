{import '@packs.latte'}

{block title}Otevřené balíčky{/block}

{block head}
  {include parent}
  {include cardStyles}
{/block}

{block content}
<div class="container">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-3">
    <h1 class="h3 m-0">
      {if count($packs) === 1}Otevřený balíček{else}Otevřeno {count($packs)} balíčků{/if}
    </h1>
    <a n:href="backpack" class="btn btn-ghost">Batoh</a>
  </div>

  {* ==== Souhrn (u více balíčků) ==== *}
  <div n:if="count($packs) > 1" class="nr-glass p-3 rounded-4 mb-4">
    <span style="opacity:.75">Celkem padlo:</span>
    {foreach $raritySummary as $code => $item}
      <span class="r-{$code} r-label ms-2">{$item['count']}× {$item['rarity']->getName()}</span>{sep},{/sep}
    {/foreach}
  </div>

  {* ==== Balíčky ==== *}
  <div n:foreach="$packs as $pack" class="mb-4">
    <div class="mb-2">
      <strong>Balíček {$pack->getFaction()->getName()}</strong>
      <small style="opacity:.75">
        • {$pack->getOpenNumber()}. otevřený
        {if $pack->getGuarantee()} • garance {$pack->getGuarantee()->getName()}{if $pack->getGuarantee()->getCode() !== 'L'}+{/if}{/if}
      </small>
    </div>
    <div class="row row-cols-2 row-cols-md-5 g-3">
      <div n:foreach="$pack->getCards() as $packCard" class="col">
        {var $card = $packCard->getCard()}
        {var $rarity = $card->getRarity()}
        <div class="nr-glass rounded-4 p-2 h-100 pack-card r-{$rarity->getCode()}">
          <span n:if="$packCard->isGuaranteed()" class="badge bg-warning text-dark badge-corner">Garance</span>
          <img src="{$basePath}{$card->getImagePath()}" alt="{$card->getName()}">
          <div class="mt-2 fw-bold">{$card->getName()}</div>
          <div class="d-flex justify-content-between">
            <span class="r-label">{$rarity->getName()}</span>
            <small style="opacity:.75">{$card->getFaction()?->getName()}</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  {* ==== Otevřít další ==== *}
  {var $lastSlug = $lastFaction->getSlug()}
  <div class="nr-glass p-3 rounded-4 mb-3">
    {if isset($packGroups[$lastSlug])}
      <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
        <div>
          <strong>Otevřít další balíček {$lastFaction->getName()}</strong><br>
          <small style="opacity:.75">zbývá {$packGroups[$lastSlug]['count']}× {$lastFaction->getName()}</small>
        </div>
        {include openControls, key: $lastSlug, available: $packGroups[$lastSlug]['count'], max: $maxOpenAtOnce}
      </div>
    {else}
      <strong>Balíčky {$lastFaction->getName()} došly.</strong>
    {/if}

    <hr class="my-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
      {if $packsTotal}
        <span style="opacity:.85">V batohu zbývá celkem <strong>{$packsTotal}</strong>:</span>
        {foreach $packGroups as $group}
          <span>{$group['count']}× {$group['faction']->getName()}</span>{sep},{/sep}
        {/foreach}
        <a n:href="backpack" class="ms-auto">Do batohu</a>
      {else}
        <span>Batoh je prázdný.</span>
        <a n:href="Shop:default" class="ms-auto">Koupit balíčky</a>
      {/if}
    </div>
  </div>

  <div class="nr-glass p-3 rounded-4">
    {include guaranteeInfo}
  </div>
</div>
{/block}
