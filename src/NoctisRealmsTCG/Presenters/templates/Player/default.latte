{block head}
  {include parent}
  <link rel="stylesheet" href="{$basePath}/assets/css/player.css?v={$assetsVer}">
{/block}

{block content}
{var $nick = $player?->nickname ?? $player?->user?->email ?? ''}
{var $initial = $nick ? strtoupper(substr($nick, 0, 1)) : 'N'}
{var $email = $player?->user?->email ?? null}
{var $level = $level ?? 1}
{var $xp = $xp ?? 0}
{var $xpToNext = $xpToNext ?? 100}
{var $xpPct = $xpPct ?? 0}
{var $slug = $seasonFaction?->slug}
{var $currentSlug = ($player?->faction?->slug ?? 'noctis')}
{var $seasonSlug  = $seasonFaction?->slug ?? $currentSlug}
{var $seasonColor = $seasonFaction?->color ?? ($player?->faction?->color ?? '#6A1B9A')}

<div class="container py-4">
  
  <!-- Sekce 1: Profil -->
  <section id="player" class="pr-section">
    <div class="nr-player-skin f-{$currentSlug}">
      <div class="nr-glass p-3 p-md-4 rounded-4 mb-3">
        <div class="row g-4">
          <div class="col-12 col-lg-4">
            <div class="nr-hero rounded-4" style="--hero: url('{$basePath}{$avatarPath}');">
              <div class="nr-level-badge nr-level-big">{$level}</div>
            </div>
          </div>

          <div class="col-12 col-lg-8">
            <div class="nr-grid">
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Jméno</div>
                  <div class="nr-stat-value top-row">{$player?->nickname ?? '—'}</div>
                </div>
              </div>
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Frakce</div>
                  <div class="nr-stat-value top-row">{$player?->faction?->name ?? '—'}</div>
                </div>
              </div>
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Email</div>
                  <div class="nr-stat-value top-row">{$email}</div>
                </div>
              </div>
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Počet karet</div>
                  <div class="nr-stat-value">{$player?->cards ?? 0}</div>
                </div>
              </div>
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Otevřené balíčky</div>
                  <div class="nr-stat-value">{$player?->openedPacks ?? 0}</div>
                </div>
              </div>
              <div class="nr-stat">
                <div class="nr-box">
                  <div class="nr-stat-label">Achievementy</div>
                  <div class="nr-stat-value">{$player?->achievements ?? 0}</div>
                </div>
              </div>

              <div class="nr-full">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="nr-label">Postup na další úroveň</div>
                  <div class="text-muted small">{$xp} / {$xpToNext} XP</div>
                </div>
                <div class="nr-progress" style="--pct: {$xpPct}%;"><div class="nr-progress-bar"></div></div>
              </div>

              {if $player?->faction?->description}
                <div class="nr-full">
                  <div class="nr-label">Popis frakce</div>
                  <div class="nr-box">{$player->faction->description}</div>
                </div>
              {/if}

              <div class="nr-actions nr-full d-flex flex-wrap gap-2">
                <a n:href="collection" class="btn">Kolekce</a>
                <a n:href="backpack" class="btn btn-ghost">Batoh{if $backpackCount} ({$backpackCount}){/if}</a>
                <a n:href="Shop:default" class="btn btn-ghost">Obchod</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Sekce 2: Sezóny -->
  <section id="seasons" class="pr-section">
    <div class="nr-season-tab f-{$slug}">
      <div class="nr-season-header">
        <!-- Frakce vlevo -->
        <div class="nr-faction-brand">
          <div class="nr-faction-badge" style="background-image:url('{$basePath}/assets/factions/{$seasonFactionSlug}.png')"></div>
          <div>
            <div class="nr-faction-name">{$seasonFaction?->name}</div>
            <div class="nr-faction-sub">{$seasonFaction?->start} – {$seasonFaction?->end}</div>
          </div>
        </div>

        <!-- Uprostřed -->
        <div class="nr-center-stats">
          <div class="nr-pill">
            <div class="nr-pill-label">Pozice</div>
            <div class="nr-pill-value">{ifset $seasonFaction?->rank}#{$seasonFaction?->rank}{else}—{/ifset}</div>
          </div>
          <div class="nr-pill">
            <div class="nr-pill-label">Body celkem</div>
            <div class="nr-pill-value">{$f['points']}</div>
          </div>
        </div>

        <!-- Filtr vpravo -->
        <div class="nr-season-filter">
          <label for="seasonSel" class="nr-label">Sezóna</label>
          <select id="seasonSel" class="nr-select" data-base-url="{link this, season => null}">
            {foreach $seasons as $s}
              <option value="{$s->id}" n:attr="selected => ($presenter->season ? $presenter->season === $s->id : $iterator->isFirst())">
                {$s->name}
              </option>
            {/foreach}
          </select>
        </div>
      </div>

      <div class="cards-row cards-row--top">
        <div class="rarity-card common light" style="--crop:12px">
          <img class="rc-img" src="{$basePath}/assets/cards/common-back.png" alt="Common">
          <div class="rc-value">{$f['common']}</div>
        </div>
        <div class="rarity-card uncommon light" style="--crop:12px">
          <img class="rc-img" src="{$basePath}/assets/cards/uncommon-back.png" alt="Uncommon">
          <div class="rc-value">{$f['uncommon']}</div>
        </div>
        <div class="rarity-card rare dark" style="--crop:12px">
          <img class="rc-img" src="{$basePath}/assets/cards/rare-back.png" alt="Rare">
          <div class="rc-value">{$f['rare']}</div>
        </div>
      </div>

      <div class="cards-row cards-row--bottom">
        <div class="rarity-card epic dark" style="--crop:12px">
          <img class="rc-img" src="{$basePath}/assets/cards/epic-back.png" alt="Epic">
          <div class="rc-value">{$f['epic']}</div>
        </div>
        <div class="rarity-card legendary dark" style="--crop:12px">
          <img class="rc-img" src="{$basePath}/assets/cards/legendary-back.png" alt="Legendary">
          <div class="rc-value">{$f['legendary']}</div>
        </div>
      </div>
    </div>
  </section>


  <!-- Sekce 3: Úspěchy -->
  <section id="achievements" class="pr-section">
    <div class="nr-glass p-3 p-md-4 rounded-4">
      <div class="nr-title mb-3">Úspěchy & Karty</div>
      <div class="nr-grid">
        <div class="nr-stat">
          <div class="nr-box">
            <div class="nr-stat-label">Achievementy</div>
            <div class="nr-stat-value">{$player?->achievements ?? 0}</div>
          </div>
        </div>
        <div class="nr-stat">
          <div class="nr-box">
            <div class="nr-stat-label">Karty celkem</div>
            <div class="nr-stat-value">{$player?->cards ?? 0}</div>
          </div>
        </div>
        <div class="nr-full">
          <div class="nr-label">Karty</div>
          <div class="nr-box d-flex flex-wrap gap-2 align-items-center">
            <span>{$player?->cards ?? 0} karet v kolekci, {$backpackCount} neotevřených balíčků.</span>
            <a n:href="collection" class="btn btn-sm ms-auto">Kolekce a darování</a>
            <a n:href="backpack" class="btn btn-sm btn-ghost">Batoh</a>
          </div>
        </div>
        <div class="nr-full">
          <div class="nr-label">Odznaky (WIP)</div>
          <div class="nr-box">Sem pak hodíme výpis odznaků…</div>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- Smooth scroll -->
<script n:syntax="off">
  document.querySelectorAll('.pr-stick a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const id = a.getAttribute('href');
      const el = document.querySelector(id);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', id);
    });
  });
</script>
{/block}
