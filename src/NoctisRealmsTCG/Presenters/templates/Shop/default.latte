{block content}
<div class="container">
  <h1>Obchod</h1>

  {* ==== Balíčky ==== *}
  <section n:if="$user->isLoggedIn()" class="mb-5">
    <h2 class="h4 mt-3">Balíčky</h2>
    <p class="mb-3" style="opacity:.8">
      Každý balíček obsahuje {$packSize} karet své frakce a neutrální karty a stojí <strong>{$packPrice} Moon Dustu</strong>.
      Koupené balíčky najdeš v <a n:href="Player:backpack">batohu</a>, otevřít je můžeš kdykoli.
    </p>
    <div class="row g-3">
      <div n:foreach="$packFactions as $packFaction" class="col-md-4">
        {var $slug = $packFaction->getSlug()}
        <div class="nr-glass p-3 rounded-4 h-100 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="{$basePath}/assets/factions/{$slug}.png" alt="" width="56" height="56" style="object-fit:contain">
            <div>
              <div class="fw-bold" style="color:{$packFaction->getColor()}">Balíček {$packFaction->getName()}</div>
              <small style="opacity:.75">{$packSize} karet • {$packPrice} MD</small>
            </div>
          </div>
          {form "buyPackForm-$slug", class: 'mt-auto'}
            <div n:foreach="$form->getErrors() as $error" class="alert error py-1 px-2 mb-2">{$error}</div>
            <div class="d-flex gap-2 align-items-center">
              {input count, class: 'form-control form-control-sm', style: 'width:5rem'}
              {input buy, class: 'btn flex-grow-1'}
            </div>
          {/form}
        </div>
      </div>
    </div>
  </section>

  <h2 class="h4">Katalog karet</h2>

  <form method="get" class="filters" style="display:flex; gap:.5rem; flex-wrap:wrap;">
    <input type="text" name="q" placeholder="Hledat…" value="{$filters['search']}">
    <select name="rarity">
      <option value="">Rarita</option>
      <option n:foreach="$rarities as $r"
              value="{$r->getCode()}" n:attr="selected: $filters['rarity'] === $r->getCode()">{$r->getName()}</option>
    </select>
    <select name="faction">
      <option value="">Frakce</option>
      <option n:foreach="['ignis' => 'Ignis', 'vitae' => 'Vitae', 'noctis' => 'Noctis'] as $slug => $name"
              value="{$slug}" n:attr="selected: $filters['faction'] === $slug">{$name}</option>
    </select>
    <select name="sort">
      <option value="new" n:attr="selected: $filters['sort'] === 'new'">Nejnovější</option>
      <option value="name_asc" n:attr="selected: $filters['sort'] === 'name_asc'">Název A–Z</option>
    </select>
    <button type="submit">Filtrovat</button>
  </form>

  <div class="grid shop-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1rem; margin-top:1rem;">
    <a n:foreach="$items as $p" n:href="Shop:detail id => $p->getId()" class="card" style="display:block; padding:1rem; border:1px solid #eee; border-radius:.75rem; text-decoration:none;">
      <img src="{$basePath}{$p->getImagePath()}" alt="{$p->getName()}" style="width:100%; height:160px; object-fit:cover; border-radius:.5rem;">
      <h3 style="margin:.5rem 0">{$p->getName()}</h3>
      <p class="muted" style="opacity:.7; margin:0 0 .5rem 0">
        {$p->getFaction()?->getName()} • {$p->getRarity()->getName()}
      </p>
    </a>
  </div>

  {var $page = $filters['page'], $pages = max(1, (int) ceil($filters['total'] / $filters['perPage']))}
  <nav n:if="$pages > 1" style="display:flex; gap:.5rem; margin-top:1rem;">
    <a n:if="$page > 1" n:href="Shop:default page => $page-1, q => $filters['search'], rarity => $filters['rarity'], faction => $filters['faction'], sort => $filters['sort']">← Předchozí</a>
    <span>Strana {$page}/{$pages}</span>
    <a n:if="$page < $pages" n:href="Shop:default page => $page+1, q => $filters['search'], rarity => $filters['rarity'], faction => $filters['faction'], sort => $filters['sort']">Další →</a>
  </nav>
</div>
{/block}
