# see https://doc.nette.org/en/configuring

parameters:


application:
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping:
        *: App\Presenters\*Presenter
        Error: App\Presentation\Error\**Presenter


database:
    dsn: 'sqlite::memory:'
    user:
    password:


latte:
    strictTypes: yes
    strictParsing: yes
    extensions:
        - App\Presentation\Accessory\LatteExtension


assets:
    mapping:
        default:
            path: assets
            # type: vite  # Uncomment to activate Vite for asset building


di:
    export:
        parameters: no
        tags: no

extensions:
    console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)

console:
    name: Noctis Realms TCG
    version: 0.1

includes:
    - doctrine.neon
